{
  "functions": {
    "api/score.py": { "maxDuration": 60 },
    "api/tickers.py": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/:ticker([A-Za-z0-9-]{1,12})", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
